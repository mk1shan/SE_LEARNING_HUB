rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ratings/{ratingId} {
      allow read: if true;  // Anyone can read ratings
      allow create: if true;  // Anyone can create ratings
      allow update, delete: if false;  // No one can update or delete ratings
    }
    
    match /resources/{resourceId} {
      allow read: if true;  // Anyone can read resources
      allow create: if true;  // Anyone can create resources - simplified for testing
      allow update: if false;  // No updates allowed
      allow delete: if false;  // No deletions allowed
    }
  }
}